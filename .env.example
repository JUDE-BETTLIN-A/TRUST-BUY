# Auth.js / NextAuth Configuration
# IMPORTANT: When deploying, change localhost:3000 to your actual domain (e.g., https://yourdomain.com)
AUTH_SECRET=your-auth-secret-here
AUTH_URL=http://localhost:3000

# Legacy NextAuth (for compatibility)
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# App URL for absolute links (SEO, AI metadata, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenRouter API
OPENROUTER_API_KEY=your-openrouter-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database Connection (Neon Postgres)
DATABASE_URL="postgresql://username:password@your-neon-db-url/neondb?sslmode=require"

# ScraperAPI Configuration (for bypassing anti-bot protection)
# Get your free API key at: https://www.scraperapi.com/ (5000 free requests/month)
SCRAPER_API_KEY=

# Telegram Bot Tokens (OPTIONAL)
# You ONLY need these if you want to CREATE your own bot.
# To scrape data from recurring bots (SpendMitra, etc.), you do NOT need these. Leave them as is.
TELEGRAM_BOT_TOKEN_1=
TELEGRAM_BOT_TOKEN_2=

# Telegram User API Credentials (REQUIRED for Scraping SpendMitra/PriceWatch)
# This allows the script to "impersonate" you to talk to the bots.
# 1. Go to https://my.telegram.org
# 2. Login & Click "API development tools"
# 3. Copy/Paste these two fields:
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
