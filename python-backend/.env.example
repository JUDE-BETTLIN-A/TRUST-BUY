# Environment Variables for Price Analysis System

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/price_tracker"

# Backend Configuration
BACKEND_URL="http://localhost:8000"

# Telegram Bot Tokens (Multiple for fallback)
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN_1="your_primary_bot_token_here"
TELEGRAM_BOT_TOKEN_2="your_secondary_bot_token_here"  # Optional fallback bot

# Telegram Chat ID for testing (optional)
# TELEGRAM_CHAT_ID="@your_chat_id"

# News API for sentiment analysis (optional)
NEWS_API_KEY="your_news_api_key_here"